# ===========================================================================
# CONFIGURATION DE L'AGENT IA - SUPERVISION ZABBIX N1
# ---------------------------------------------------------------------------
# Copier ce fichier vers .env puis remplir les valeurs :
# cp .env.example .env && nano .env
#
# Le fichier .env contient des secrets : il ne doit JAMAIS etre versionne.
# ===========================================================================
P A R T I E 3
Les 15 fichiers, integraux et prets a copier. Le code est commente en
francais et suit exactement la structure que vous aviez definie. Tous les
fichiers Python ont ete verifies syntaxiquement.
# ---------------------------------------------------------------------------
# 1. LLM -- la brique interchangeable (voir cahier des charges, Partie 1)
# ---------------------------------------------------------------------------
# Groq et Ollama exposent tous deux une API "compatible OpenAI" :
# le meme code fonctionne, seules l'URL et le modele changent.
# --- CONFIGURATION ACTUELLE : GROQ (cloud, gratuit) ---
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=gsk_REMPLACER_PAR_VOTRE_CLE
LLM_MODEL=llama-3.3-70b-versatile
# --- BASCULE LOCALE (semaine 7, si confidentialite exigee) ---
# Decommenter les 3 lignes ci-dessous et commenter les 3 lignes ci-dessus.
# Prerequis : ollama pull qwen2.5:7b
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:7b
# Temperature du modele. 0 = deterministe.
# En supervision, on veut la MEME decision pour la MEME alerte : garder 0.
LLM_TEMPERATURE=0
# Nombre maximum d'etapes de la boucle ReAct (garde-fou anti-boucle infinie)
LLM_MAX_STEPS=8
# Delai maximum d'un appel LLM, en secondes.
# Groq repond en 1-3 s ; un modele local sur CPU peut prendre 20-60 s.
LLM_TIMEOUT=120
# ---------------------------------------------------------------------------
# 2. ZABBIX -- connexion a l'API JSON-RPC (VM 1)
# ---------------------------------------------------------------------------
# Remplacer l'IP par celle de la VM Zabbix.
ZABBIX_URL=http://192.168.1.10/zabbix/api_jsonrpc.php
# Jeton API cree dans l'interface : Users -> API tokens -> Create API token
# Zabbix 7.0 utilise l'en-tete Authorization: Bearer <token>.
ZABBIX_TOKEN=REMPLACER_PAR_VOTRE_JETON
# Verifier le certificat TLS (mettre false si HTTP simple en test)
ZABBIX_VERIFY_SSL=false
# ---------------------------------------------------------------------------
# 3. SECURITE -- le garde-fou principal
# ---------------------------------------------------------------------------
# true = l'agent PROPOSE ses actions sans jamais ecrire dans Zabbix (dry-run)
# false = l'agent AGIT reellement (acquitte, commente)
#
# Toujours demarrer a true. Ne passer a false qu'apres validation
# du comportement de l'agent sur des alertes de test.
DRY_RUN=true
# Severite Zabbix maximale que l'agent a le droit d'acquitter seul.
# Echelle Zabbix : 0=Non classifie 1=Information 2=Warning
# 3=Average 4=High 5=Disaster
# Au-dessus de ce seuil, l'agent DOIT escalader (regle appliquee dans le code,
# pas dans le prompt : le LLM ne peut donc pas la contourner).
MAX_AUTO_ACK_SEVERITY=2
# ---------------------------------------------------------------------------
# 4. NOTIFICATION D'ESCALADE (e-mail)
# ---------------------------------------------------------------------------
# Si false : l'escalade se limite a un message dans Zabbix (methode simple).
# Si true : un e-mail est envoye en plus.
NOTIFY_EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=agent-zabbix@nextstep-it.local
SMTP_TO=supervision-n2@nextstep-it.local
# ---------------------------------------------------------------------------
# 5. APPLICATION
# ---------------------------------------------------------------------------
# Intervalle entre deux scrutations en mode --watch (secondes)
POLL_INTERVAL=60
# Chemins des donnees (relatifs a la racine du projet)
DB_PATH=data/agent.db
LOG_PATH=data/agent.log
# Console web
WEB_HOST=0.0.0.0
WEB_PORT=8000
