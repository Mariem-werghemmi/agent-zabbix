# =====================================================================
# Image de la CONSOLE WEB (service agent-web : web.py / FastAPI)
# Build depuis la RACINE du projet :
#   docker build -f docker/Dockerfile.web -t agent-zabbix-web .
#
# Memes bonnes pratiques que l'agent. Expose le port de la console (8000).
# =====================================================================
FROM python:3.12-slim AS build
WORKDIR /install
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip setuptools \
    && python -m venv /venv \
    && /venv/bin/pip install --no-cache-dir --upgrade pip setuptools \
    && /venv/bin/pip install --no-cache-dir -r requirements.txt
FROM python:3.12-slim AS runtime
# Mise a jour du pip systeme (corrige les CVE de ses dependances vendues, ex. msgpack)
RUN pip install --no-cache-dir --upgrade pip setuptools
# Mise a jour du pip systeme (corrige les CVE de ses dependances vendues, ex. msgpack)
RUN pip install --no-cache-dir --upgrade pip setuptools \
    # Suppression du wheel pip fige embarque par ensurepip (contient une vieille
    # copie vendue de msgpack/setuptools, jamais utilisee par notre build).
    && rm -rf /usr/local/lib/python3.12/ensurepip/_bundled/*.whl
# Utilisateur non-root : si le conteneur est compromis, pas de droits root.
RUN useradd --uid 10001 --create-home --shell /usr/sbin/nologin appuser

WORKDIR /app
COPY --from=build /venv /venv
COPY . /app

RUN mkdir -p /app/data && chown -R 10001:10001 /app/data

ENV PATH="/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    WEB_HOST=0.0.0.0 \
    WEB_PORT=8000

USER 10001
EXPOSE 8000

# Healthcheck : la console repond-elle sur son port ?
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/').status==200 else 1)"

CMD ["python", "web.py"]
