# =====================================================================
# Image de l'AGENT (service agent-watch : cli.py --watch)
# Build depuis la RACINE du projet :
#   docker build -f docker/Dockerfile.agent -t agent-zabbix-agent .
#
# Bonnes pratiques : multi-stage, base slim, utilisateur non-root, healthcheck.
# Le serveur Zabbix est EXTERNE (autre VM) : son URL vient d'une variable
# d'environnement (ZABBIX_URL), jamais en dur dans l'image.
# =====================================================================

# ---- Etage 1 : build des dependances dans un venv isole -------------
FROM python:3.12-slim AS build
WORKDIR /install
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip setuptools \
    && python -m venv /venv \
    && /venv/bin/pip install --no-cache-dir --upgrade pip setuptools \
    && /venv/bin/pip install --no-cache-dir -r requirements.txt
# ---- Etage 2 : image finale minimale ---------------------------------
FROM python:3.12-slim AS runtime

# Mise a jour du pip systeme (corrige les CVE de ses dependances vendues, ex. msgpack)
RUN pip install --no-cache-dir --upgrade pip setuptools
# Mise a jour du pip systeme (corrige les CVE de ses dependances vendues, ex. msgpack)
RUN pip install --no-cache-dir --upgrade pip setuptools \
    # Suppression du wheel pip fige embarque par ensurepip (contient une vieille
    # copie vendue de msgpack/setuptools, jamais utilisee par notre build).
    && rm -rf /usr/local/lib/python3.12/ensurepip/_bundled/*.whl
# Utilisateur non-root : si le conteneur est compromis, pas de droits root.
RUN useradd --uid 10001 --create-home --shell /usr/sbin/nologin appuser

WORKDIR /app
COPY --from=build /venv /venv
# On copie le code applicatif (le .dockerignore exclut secrets, data, venv...)
COPY . /app

# data/ doit etre inscriptible par l'utilisateur non-root (volume monte ensuite)
RUN mkdir -p /app/data && chown -R 10001:10001 /app/data

ENV PATH="/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

USER 10001

# Healthcheck : le conteneur est "healthy" tant que le process Python tourne
# et que la base de journalisation est accessible.
HEALTHCHECK --interval=60s --timeout=5s --start-period=15s --retries=3 \
  CMD python -c "import sqlite3,os; sqlite3.connect(os.environ.get('DB_PATH','data/agent.db')).close()" || exit 1

# Surveillance continue : traite les alertes en boucle.
CMD ["python", "cli.py", "--watch"]
